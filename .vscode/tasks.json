{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build and run mealplan",
      "type": "shell",
      "command": "mkdir -p backend/c/output && cc -std=c11 -Wall -Wextra -Wpedantic -Werror backend/c/main.c -o backend/c/output/mealplan && ./backend/c/output/mealplan",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": ["$gcc"]
    }
  ]
}
