/* ----------------------------------------------------------------------- */
/* Growable byte buffer                                                     */
/* ----------------------------------------------------------------------- */
typedef struct { char *data; size_t len, cap; } Buf;

static void buf_init(Buf *b) { b->data = malloc(1); b->data[0] = 0; b->len = 0; b->cap = 1; }
static void buf_free(Buf *b) { free(b->data); b->data = NULL; b->len = b->cap = 0; }
static void buf_put(Buf *b, const char *p, size_t n) {
    if (b->len + n + 1 > b->cap) {
        while (b->len + n + 1 > b->cap) b->cap *= 2;
        b->data = realloc(b->data, b->cap);
    }
    memcpy(b->data + b->len, p, n); b->len += n; b->data[b->len] = 0;
}
static void buf_putc(Buf *b, char c) { buf_put(b, &c, 1); }

/* ----------------------------------------------------------------------- */
/* HTTP GET via libcurl                                                     */
/* ----------------------------------------------------------------------- */
static size_t write_cb(char *ptr, size_t sz, size_t nm, void *ud) {
    buf_put((Buf *)ud, ptr, sz * nm); return sz * nm;
}

/* GET url with optional extra headers (NULL-terminated array). Returns 0 on success,
 * filling *out (caller buf_free). *http set to status code. */
static int http_get(const char *url, const char **headers, Buf *out, long *http) {
    CURL *c = curl_easy_init();
    if (!c) return -1;
    struct curl_slist *hl = NULL;
    hl = curl_slist_append(hl, "Accept: application/json");
    hl = curl_slist_append(hl, "User-Agent: pricewatch-c/1.0 (+personal use)");
    for (const char **h = headers; h && *h; h++) hl = curl_slist_append(hl, *h);
    curl_easy_setopt(c, CURLOPT_URL, url);
    curl_easy_setopt(c, CURLOPT_HTTPHEADER, hl);
    curl_easy_setopt(c, CURLOPT_WRITEFUNCTION, write_cb);
    curl_easy_setopt(c, CURLOPT_WRITEDATA, out);
    curl_easy_setopt(c, CURLOPT_FOLLOWLOCATION, 1L);
    curl_easy_setopt(c, CURLOPT_TIMEOUT, 25L);
    CURLcode rc = curl_easy_perform(c);
    if (http) curl_easy_getinfo(c, CURLINFO_RESPONSE_CODE, http);
    curl_slist_free_all(hl);
    curl_easy_cleanup(c);
    return rc == CURLE_OK ? 0 : -1;
}

/* ----------------------------------------------------------------------- */
/* Minimal JSON parser -> tagged tree                                       */
/* ----------------------------------------------------------------------- */
typedef enum { J_NULL, J_BOOL, J_NUM, J_STR, J_ARR, J_OBJ } Jtype;
typedef struct Jval Jval;
typedef struct Jmember { char *key; Jval *val; struct Jmember *next; } Jmember;
struct Jval {
    Jtype t;
    union {
        int b;
        double num;
        char *str;                      /* owned, UTF-8, NUL-terminated */
        struct { Jval **items; size_t n; } arr;
        Jmember *obj;                   /* linked list */
    } u;
};

typedef struct { const char *p; } Jparser;

static Jval *jparse_value(Jparser *j);

static void jskip(Jparser *j) {
    while (*j->p == ' ' || *j->p == '\t' || *j->p == '\n' || *j->p == '\r') j->p++;
}

static void utf8_encode(Buf *b, unsigned cp) {
    if (cp < 0x80) buf_putc(b, (char)cp);
    else if (cp < 0x800) { buf_putc(b, 0xC0 | (cp >> 6)); buf_putc(b, 0x80 | (cp & 0x3F)); }
    else if (cp < 0x10000) {
        buf_putc(b, 0xE0 | (cp >> 12)); buf_putc(b, 0x80 | ((cp >> 6) & 0x3F));
        buf_putc(b, 0x80 | (cp & 0x3F));
    } else {
        buf_putc(b, 0xF0 | (cp >> 18)); buf_putc(b, 0x80 | ((cp >> 12) & 0x3F));
        buf_putc(b, 0x80 | ((cp >> 6) & 0x3F)); buf_putc(b, 0x80 | (cp & 0x3F));
    }
}

static char *jparse_rawstring(Jparser *j) {
    if (*j->p != '"') return NULL;
    j->p++;
    Buf b; buf_init(&b);
    while (*j->p && *j->p != '"') {
        if (*j->p == '\\') {
            j->p++;
            char c = *j->p++;
            switch (c) {
                case 'n': buf_putc(&b, '\n'); break;
                case 't': buf_putc(&b, '\t'); break;
                case 'r': buf_putc(&b, '\r'); break;
                case 'b': buf_putc(&b, '\b'); break;
                case 'f': buf_putc(&b, '\f'); break;
                case '/': buf_putc(&b, '/'); break;
                case '\\': buf_putc(&b, '\\'); break;
                case '"': buf_putc(&b, '"'); break;
                case 'u': {
                    unsigned cp = (unsigned)strtol((char[]){j->p[0],j->p[1],j->p[2],j->p[3],0}, NULL, 16);
                    j->p += 4;
                    if (cp >= 0xD800 && cp <= 0xDBFF && j->p[0]=='\\' && j->p[1]=='u') {
                        j->p += 2;
                        unsigned lo = (unsigned)strtol((char[]){j->p[0],j->p[1],j->p[2],j->p[3],0}, NULL, 16);
                        j->p += 4;
                        cp = 0x10000 + ((cp - 0xD800) << 10) + (lo - 0xDC00);
                    }
                    utf8_encode(&b, cp);
                    break;
                }
                default: buf_putc(&b, c); break;
            }
        } else {
            buf_putc(&b, *j->p++);
        }
    }
    if (*j->p == '"') j->p++;
    return b.data; /* caller frees */
}

static Jval *jnew(Jtype t) { Jval *v = calloc(1, sizeof(Jval)); v->t = t; return v; }

static Jval *jparse_value(Jparser *j) {
    jskip(j);
    char c = *j->p;
    if (c == '"') { Jval *v = jnew(J_STR); v->u.str = jparse_rawstring(j); return v; }
    if (c == '{') {
        j->p++; Jval *v = jnew(J_OBJ); Jmember **tail = &v->u.obj;
        jskip(j);
        if (*j->p == '}') { j->p++; return v; }
        for (;;) {
            jskip(j);
            char *key = jparse_rawstring(j);
            jskip(j); if (*j->p == ':') j->p++;
            Jval *val = jparse_value(j);
            Jmember *m = calloc(1, sizeof(Jmember)); m->key = key; m->val = val;
            *tail = m; tail = &m->next;
            jskip(j);
            if (*j->p == ',') { j->p++; continue; }
            if (*j->p == '}') { j->p++; break; }
            break;
        }
        return v;
    }
    if (c == '[') {
        j->p++; Jval *v = jnew(J_ARR); jskip(j);
        if (*j->p == ']') { j->p++; return v; }
        size_t cap = 8; v->u.arr.items = malloc(cap * sizeof(Jval*));
        for (;;) {
            Jval *it = jparse_value(j);
            if (v->u.arr.n == cap) { cap *= 2; v->u.arr.items = realloc(v->u.arr.items, cap*sizeof(Jval*)); }
            v->u.arr.items[v->u.arr.n++] = it;
            jskip(j);
            if (*j->p == ',') { j->p++; continue; }
            if (*j->p == ']') { j->p++; break; }
            break;
        }
        return v;
    }
    if (c == 't') { j->p += 4; Jval *v = jnew(J_BOOL); v->u.b = 1; return v; }
    if (c == 'f') { j->p += 5; Jval *v = jnew(J_BOOL); v->u.b = 0; return v; }
    if (c == 'n') { j->p += 4; return jnew(J_NULL); }
    /* number */
    char *end; double d = strtod(j->p, &end);
    Jval *v = jnew(J_NUM); v->u.num = d; j->p = end; return v;
}

static Jval *json_parse(const char *s) { Jparser j = { s }; return jparse_value(&j); }

static void json_free(Jval *v) {
    if (!v) return;
    if (v->t == J_STR) free(v->u.str);
    else if (v->t == J_ARR) { for (size_t i=0;i<v->u.arr.n;i++) json_free(v->u.arr.items[i]); free(v->u.arr.items); }
    else if (v->t == J_OBJ) {
        for (Jmember *m = v->u.obj; m; ) { Jmember *nx = m->next; free(m->key); json_free(m->val); free(m); m = nx; }
    }
    free(v);
}

/* accessors (all NULL-safe) */
static Jval *jget(Jval *o, const char *key) {
    if (!o || o->t != J_OBJ) return NULL;
    for (Jmember *m = o->u.obj; m; m = m->next) if (m->key && strcmp(m->key, key) == 0) return m->val;
    return NULL;
}
static const char *jstr(Jval *v) { return (v && v->t == J_STR) ? v->u.str : NULL; }
static const char *jstr_at(Jval *o, const char *k) { return jstr(jget(o, k)); }
static int jhas_num(Jval *v) { return v && v->t == J_NUM; }
static int jbool_at(Jval *o, const char *k) { Jval *v = jget(o, k); return v && v->t == J_BOOL && v->u.b; }

/* ----------------------------------------------------------------------- */
/* Normalized offer + name normalization                                    */
/* ----------------------------------------------------------------------- */
typedef struct {
    const char *name;        /* not owned; valid during ingest call */
    double price;
    int has_original; double original;
    const char *currency;    /* default DKK */
    const char *kind;        /* regular | food_waste | offer */
    const char *source;
    const char *store_brand; /* may be NULL */
    const char *store_id;    /* may be NULL */
    const char *ean;         /* may be NULL */
} Offer;

/* Lowercase + collapse whitespace into dst (size cap). Lowercases ASCII and the
 * Latin-1 accented letters (so Æ Ø Å -> æ ø å), which is what Danish names need. */
static void norm_name(char *dst, size_t cap, const char *src) {
    size_t o = 0; int prev_space = 1;
    const unsigned char *s = (const unsigned char *)src;
    for (; *s && o + 2 < cap; ) {
        unsigned char ch = *s;
        if (ch == ' ' || ch == '\t' || ch == '\n' || ch == '\r') {
            if (!prev_space) { dst[o++] = ' '; prev_space = 1; }
            s++;
        } else if (ch < 128) {
            dst[o++] = (char)tolower(ch); prev_space = 0; s++;
        } else if (ch == 0xC3 && s[1] >= 0x80 && s[1] <= 0x9E && s[1] != 0x97) {
            /* UTF-8 Latin-1 uppercase -> lowercase (second byte + 0x20) */
            dst[o++] = (char)0xC3; dst[o++] = (char)(s[1] + 0x20); prev_space = 0; s += 2;
        } else {
            dst[o++] = (char)ch; prev_space = 0; s++;
        }
    }
    while (o > 0 && dst[o-1] == ' ') o--;
    dst[o] = 0;
}

/* Word-start match with Danish inflection tolerance: `needle` must begin a word in
 * `hay` (boundary before), and end either at a word boundary or after a short Danish
 * inflection suffix (so "tomat" matches "tomater", "kaffe" matches "kaffen"). The
 * required boundary BEFORE the needle is what stops "æg" matching inside "pålæg" and
 * "kaffe" inside "iskaffe". Non-ASCII bytes (æøå) count as word characters. Both
 * strings are expected already normalized (lowercase). */
static int is_word_char(unsigned char c) { return isalnum(c) || c >= 0x80; }

/* Common Danish noun inflection endings, longest first. "" = exact word boundary. */
static const char *DK_SUFFIX[] = { "erne", "ene", "er", "en", "et", "ne", "e", "r", "s", "", NULL };

static int boundary_at(const char *p) { return *p == 0 || !is_word_char((unsigned char)*p); }

static int word_contains(const char *hay, const char *needle) {
    if (!hay || !needle || !*needle) return 0;
    size_t nlen = strlen(needle);
    for (const char *p = strstr(hay, needle); p; p = strstr(p + 1, needle)) {
        if (p != hay && is_word_char((unsigned char)p[-1])) continue;  /* must start a word */
        const char *after = p + nlen;
        for (const char **suf = DK_SUFFIX; *suf; suf++) {
            size_t sl = strlen(*suf);
            if (strncmp(after, *suf, sl) == 0 && boundary_at(after + sl)) return 1;
        }
    }
    return 0;
}

/* SQLite scalar function: wmatch(name, term) -> 1 if term is a whole-word match. */
static void sql_wmatch(sqlite3_context *ctx, int argc, sqlite3_value **argv) {
    (void)argc;
    const char *hay = (const char *)sqlite3_value_text(argv[0]);
    const char *ndl = (const char *)sqlite3_value_text(argv[1]);
    sqlite3_result_int(ctx, word_contains(hay, ndl));
}

/* ----------------------------------------------------------------------- */
/* SQLite storage                                                           */
/* ----------------------------------------------------------------------- */
static sqlite3 *DB;

static void db_open(const char *path) {
    if (sqlite3_open(path, &DB) != SQLITE_OK) {
        fprintf(stderr, "cannot open db %s: %s\n", path, sqlite3_errmsg(DB)); exit(1);
    }
    const char *schema =
        "CREATE TABLE IF NOT EXISTS products("
        " id INTEGER PRIMARY KEY AUTOINCREMENT, ean TEXT UNIQUE, name TEXT NOT NULL, brand TEXT);"
        "CREATE TABLE IF NOT EXISTS offers("
        " id INTEGER PRIMARY KEY AUTOINCREMENT, product_id INTEGER NOT NULL,"
        " price REAL NOT NULL, original_price REAL, currency TEXT DEFAULT 'DKK',"
        " kind TEXT, source TEXT, store_brand TEXT, store_id TEXT, observed_at TEXT NOT NULL);"
        "CREATE INDEX IF NOT EXISTS ix_products_name ON products(name);"
        "CREATE INDEX IF NOT EXISTS ix_offers_product ON offers(product_id);";
    char *err = NULL;
    if (sqlite3_exec(DB, schema, NULL, NULL, &err) != SQLITE_OK) {
        fprintf(stderr, "schema error: %s\n", err); exit(1);
    }
    sqlite3_create_function(DB, "wmatch", 2, SQLITE_UTF8, NULL, sql_wmatch, NULL, NULL);
}

static sqlite3_int64 db_match_product(const Offer *o) {
    sqlite3_stmt *st;
    if (o->ean && *o->ean) {
        sqlite3_prepare_v2(DB, "SELECT id FROM products WHERE ean=?", -1, &st, NULL);
        sqlite3_bind_text(st, 1, o->ean, -1, SQLITE_TRANSIENT);
        if (sqlite3_step(st) == SQLITE_ROW) { sqlite3_int64 id = sqlite3_column_int64(st, 0); sqlite3_finalize(st); return id; }
        sqlite3_finalize(st);
        sqlite3_prepare_v2(DB, "INSERT INTO products(ean,name,brand) VALUES(?,?,?)", -1, &st, NULL);
        sqlite3_bind_text(st, 1, o->ean, -1, SQLITE_TRANSIENT);
        sqlite3_bind_text(st, 2, o->name, -1, SQLITE_TRANSIENT);
        sqlite3_bind_text(st, 3, o->store_brand, -1, SQLITE_TRANSIENT);
        sqlite3_step(st); sqlite3_finalize(st);
        return sqlite3_last_insert_rowid(DB);
    }
    char norm[512]; norm_name(norm, sizeof norm, o->name);
    sqlite3_prepare_v2(DB, "SELECT id FROM products WHERE ean IS NULL AND name=?", -1, &st, NULL);
    sqlite3_bind_text(st, 1, norm, -1, SQLITE_TRANSIENT);
    if (sqlite3_step(st) == SQLITE_ROW) { sqlite3_int64 id = sqlite3_column_int64(st, 0); sqlite3_finalize(st); return id; }
    sqlite3_finalize(st);
    sqlite3_prepare_v2(DB, "INSERT INTO products(ean,name,brand) VALUES(NULL,?,?)", -1, &st, NULL);
    sqlite3_bind_text(st, 1, norm, -1, SQLITE_TRANSIENT);
    sqlite3_bind_text(st, 2, o->store_brand, -1, SQLITE_TRANSIENT);
    sqlite3_step(st); sqlite3_finalize(st);
    return sqlite3_last_insert_rowid(DB);
}

static void now_iso(char *out, size_t n) {
    time_t t = time(NULL); struct tm tm; gmtime_r(&t, &tm);
    strftime(out, n, "%Y-%m-%dT%H:%M:%SZ", &tm);
}

static void db_insert_offer(sqlite3_int64 pid, const Offer *o) {
    char ts[32]; now_iso(ts, sizeof ts);
    sqlite3_stmt *st;
    sqlite3_prepare_v2(DB,
        "INSERT INTO offers(product_id,price,original_price,currency,kind,source,store_brand,store_id,observed_at)"
        " VALUES(?,?,?,?,?,?,?,?,?)", -1, &st, NULL);
    sqlite3_bind_int64(st, 1, pid);
    sqlite3_bind_double(st, 2, o->price);
    if (o->has_original) sqlite3_bind_double(st, 3, o->original); else sqlite3_bind_null(st, 3);
    sqlite3_bind_text(st, 4, o->currency ? o->currency : "DKK", -1, SQLITE_TRANSIENT);
    sqlite3_bind_text(st, 5, o->kind, -1, SQLITE_TRANSIENT);
    sqlite3_bind_text(st, 6, o->source, -1, SQLITE_TRANSIENT);
    sqlite3_bind_text(st, 7, o->store_brand, -1, SQLITE_TRANSIENT);
    sqlite3_bind_text(st, 8, o->store_id, -1, SQLITE_TRANSIENT);
    sqlite3_bind_text(st, 9, ts, -1, SQLITE_TRANSIENT);
    sqlite3_step(st); sqlite3_finalize(st);
}

static int INGESTED;
static void ingest(const Offer *o) {
    sqlite3_int64 pid = db_match_product(o);
    db_insert_offer(pid, o);
    INGESTED++;
}

/* ----------------------------------------------------------------------- */
/* Adapters                                                                  */
/* ----------------------------------------------------------------------- */
#define TJEK_BASE "https://squid-api.tjek.com/v2"
#define REMA_BASE "https://api.digital.rema1000.dk/api"
#define SALLING_DEFAULT "https://api.sallinggroup.com"

static const char *DK_GROCERY[] = {
    "netto","bilka","føtex","fotex","rema 1000","kvickly","superbrugsen","brugsen",
    "365discount","lidl","aldi","meny","spar","min købmand","løvbjerg","abc lavpris","coop 365", NULL
};

static int name_is_dk_grocery(const char *name) {
    if (!name) return 0;
    char low[256]; norm_name(low, sizeof low, name);
    for (const char **c = DK_GROCERY; *c; c++) if (strstr(low, *c)) return 1;
    return 0;
}

/* --- Tjek --- */
static void tjek_header(const char **hdr) {
    const char *key = getenv("TJEK_API_KEY");
    static char line[256];
    if (key && *key) { snprintf(line, sizeof line, "X-Api-Key: %s", key); hdr[0] = line; hdr[1] = NULL; }
    else hdr[0] = NULL;
}

/* Collect dealers; if dk_grocery, keep only DK + grocery. Prints if print!=0,
 * else calls on_dealer(id,name) for each. */
typedef void (*dealer_cb)(const char *id, const char *name);
static void tjek_dealers(int dk_grocery, int print, dealer_cb cb) {
    const char *hdr[2]; tjek_header(hdr);
    for (int off = 0; off < 600; off += 100) {
        char url[256]; snprintf(url, sizeof url, TJEK_BASE "/dealers?limit=100&offset=%d", off);
        Buf b; buf_init(&b); long code = 0;
        if (http_get(url, hdr, &b, &code) != 0 || code != 200) { buf_free(&b); break; }
        Jval *arr = json_parse(b.data);
        if (!arr || arr->t != J_ARR || arr->u.arr.n == 0) { json_free(arr); buf_free(&b); break; }
        for (size_t i = 0; i < arr->u.arr.n; i++) {
            Jval *d = arr->u.arr.items[i];
            const char *id = jstr_at(d, "id"), *name = jstr_at(d, "name");
            const char *country = jstr_at(jget(d, "country"), "id");
            if (dk_grocery && !(country && strcmp(country, "DK") == 0 && name_is_dk_grocery(name))) continue;
            if (print) printf("%-12s %s%s%s\n", id ? id : "?", name ? name : "",
                              country ? " [" : "", country ? country : "");
            else if (cb) cb(id, name);
        }
        json_free(arr); buf_free(&b);
    }
}

static void tjek_fetch_dealer(const char *dealer_id, int dk_filter) {
    const char *hdr[2]; tjek_header(hdr);
    for (int off = 0; off < 300; off += 100) {
        char url[256];
        if (dealer_id) snprintf(url, sizeof url, TJEK_BASE "/offers?limit=100&offset=%d&dealer_id=%s", off, dealer_id);
        else           snprintf(url, sizeof url, TJEK_BASE "/offers?limit=100&offset=%d", off);
        Buf b; buf_init(&b); long code = 0;
        if (http_get(url, hdr, &b, &code) != 0 || code != 200) { buf_free(&b); break; }
        Jval *arr = json_parse(b.data);
        if (!arr || arr->t != J_ARR || arr->u.arr.n == 0) { json_free(arr); buf_free(&b); break; }
        for (size_t i = 0; i < arr->u.arr.n; i++) {
            Jval *o = arr->u.arr.items[i];
            Jval *pricing = jget(o, "pricing");
            Jval *pv = jget(pricing, "price");
            if (!jhas_num(pv)) continue;
            const char *cur = jstr_at(pricing, "currency");
            if (dk_filter && cur && strcmp(cur, "DKK") != 0) continue;
            Jval *dealer = jget(o, "dealer");
            char name[512];
            const char *head = jstr_at(o, "heading"), *desc = jstr_at(o, "description");
            /* Match on the product TITLE, not the marketing blob: keep the heading
             * and only append a SHORT description (size/variant like "1 kg."), never
             * the long prose that makes unrelated words ("gær" in a kefir ad) match. */
            if (desc && strlen(desc) <= 40)
                snprintf(name, sizeof name, "%s %s", head ? head : "(unknown)", desc);
            else
                snprintf(name, sizeof name, "%s", head ? head : "(unknown)");
            Jval *prep = jget(pricing, "pre_price");
            Offer of = {0};
            of.name = name; of.price = pv->u.num;
            of.has_original = jhas_num(prep); of.original = jhas_num(prep) ? prep->u.num : 0;
            of.currency = cur ? cur : "DKK"; of.kind = "offer"; of.source = "tjek";
            of.store_brand = jstr_at(dealer, "name"); of.store_id = jstr_at(o, "dealer_id");
            ingest(&of);
        }
        json_free(arr); buf_free(&b);
    }
}

static void dk_dealer_cb(const char *id, const char *name) { (void)name; if (id) tjek_fetch_dealer(id, 1); }

static void tjek_scrape(const char *dealer_id, int dk_grocery) {
    if (dk_grocery && !dealer_id) { tjek_dealers(1, 0, dk_dealer_cb); return; }
    tjek_fetch_dealer(dealer_id, 0);
}

/* --- REMA 1000 --- */
static void rema_scrape(void) {
    for (int page = 1; page <= 5; page++) {
        char url[256];
        snprintf(url, sizeof url,
                 REMA_BASE "/v3/products?filter%%5Bis_advertised%%5D=true&per_page=100&page=%d", page);
        Buf b; buf_init(&b); long code = 0;
        if (http_get(url, NULL, &b, &code) != 0 || code != 200) { buf_free(&b); break; }
        Jval *root = json_parse(b.data);
        Jval *data = jget(root, "data");
        if (!data || data->t != J_ARR || data->u.arr.n == 0) { json_free(root); buf_free(&b); break; }
        for (size_t i = 0; i < data->u.arr.n; i++) {
            Jval *p = data->u.arr.items[i];
            Jval *prices = jget(p, "prices");
            if (!prices || prices->t != J_ARR || prices->u.arr.n == 0) continue;
            Jval *pr = prices->u.arr.items[0];
            Jval *pv = jget(pr, "price");
            if (!jhas_num(pv)) continue;
            char name[512];
            const char *nm = jstr_at(p, "name"), *un = jstr_at(p, "underline");
            snprintf(name, sizeof name, "%s%s%s", nm ? nm : "(unknown)", un ? " " : "", un ? un : "");
            Jval *normal = jget(pr, "normal_price");
            Offer of = {0};
            of.name = name; of.price = pv->u.num;
            of.has_original = jhas_num(normal); of.original = jhas_num(normal) ? normal->u.num : 0;
            of.currency = "DKK"; of.kind = jbool_at(pr, "is_advertised") ? "offer" : "regular";
            of.source = "rema1000"; of.store_brand = "REMA 1000";
            ingest(&of);
        }
        json_free(root); buf_free(&b);
        struct timespec ts = { 0, 400L * 1000000L }; nanosleep(&ts, NULL); /* be polite */
    }
}

/* --- Salling (official API) --- */
static void salling_scrape(const char *zip, const char *ean) {
    const char *tok = getenv("SALLING_TOKEN");
    if (!tok || !*tok) { fprintf(stderr, "salling needs SALLING_TOKEN (https://developer.sallinggroup.dev)\n"); return; }
    const char *base = getenv("SALLING_BASE_URL"); if (!base) base = SALLING_DEFAULT;
    char auth[512]; snprintf(auth, sizeof auth, "Authorization: Bearer %s", tok);
    const char *hdr[2] = { auth, NULL };
    if (ean) {
        char url[512]; snprintf(url, sizeof url, "%s/v2/products/%s", base, ean);
        Buf b; buf_init(&b); long code = 0;
        if (http_get(url, hdr, &b, &code) == 0 && code == 200) {
            Jval *d = json_parse(b.data);
            Jval *pv = jget(d, "price");
            if (jhas_num(pv)) {
                const char *desc = jstr_at(d, "description");
                Offer of = {0};
                of.name = desc ? desc : "(unknown)"; of.price = pv->u.num; of.currency = "DKK";
                of.kind = "regular"; of.source = "salling"; of.ean = jstr_at(d, "ean");
                if (!of.ean) of.ean = ean;
                ingest(&of);
            }
            json_free(d);
        } else fprintf(stderr, "salling ean lookup: HTTP %ld\n", code);
        buf_free(&b);
    }
    if (zip) {
        char url[512]; snprintf(url, sizeof url, "%s/v1/food-waste/?zip=%s", base, zip);
        Buf b; buf_init(&b); long code = 0;
        if (http_get(url, hdr, &b, &code) == 0 && code == 200) {
            Jval *arr = json_parse(b.data);
            if (arr && arr->t == J_ARR) for (size_t i = 0; i < arr->u.arr.n; i++) {
                Jval *entry = arr->u.arr.items[i];
                Jval *store = jget(entry, "store");
                Jval *clr = jget(entry, "clearances");
                if (!clr || clr->t != J_ARR) continue;
                for (size_t k = 0; k < clr->u.arr.n; k++) {
                    Jval *c = clr->u.arr.items[k];
                    Jval *prod = jget(c, "product"), *offer = jget(c, "offer");
                    Jval *np = jget(offer, "newPrice");
                    if (!jhas_num(np)) continue;
                    Jval *op = jget(offer, "originalPrice");
                    Offer of = {0};
                    of.name = jstr_at(prod, "description"); if (!of.name) of.name = "(unknown)";
                    of.price = np->u.num; of.has_original = jhas_num(op); of.original = jhas_num(op)?op->u.num:0;
                    of.currency = "DKK"; of.kind = "food_waste"; of.source = "salling";
                    of.ean = jstr_at(prod, "ean");
                    of.store_brand = jstr_at(store, "brand"); of.store_id = jstr_at(store, "id");
                    ingest(&of);
                }
            }
            json_free(arr);
        } else fprintf(stderr, "salling food-waste: HTTP %ld\n", code);
        buf_free(&b);
    }
}

/* ----------------------------------------------------------------------- */
/* Queries                                                                   */
/* ----------------------------------------------------------------------- */
static void cmd_latest(const char *query, int limit) {
    sqlite3_stmt *st;
    const char *sql_all =
        "SELECT p.name,o.price,o.original_price,o.currency,o.kind,o.store_brand "
        "FROM offers o JOIN products p ON p.id=o.product_id "
        "JOIN (SELECT product_id,MAX(observed_at) ts FROM offers GROUP BY product_id) m "
        "ON m.product_id=o.product_id AND m.ts=o.observed_at ";
    char sql[1024];
    if (query) snprintf(sql, sizeof sql, "%s WHERE p.name LIKE ? ORDER BY o.observed_at DESC LIMIT ?", sql_all);
    else       snprintf(sql, sizeof sql, "%s ORDER BY o.observed_at DESC LIMIT ?", sql_all);
    sqlite3_prepare_v2(DB, sql, -1, &st, NULL);
    int bi = 1;
    char like[256];
    if (query) { char q[128]; norm_name(q, sizeof q, query); snprintf(like, sizeof like, "%%%s%%", q);
                 sqlite3_bind_text(st, bi++, like, -1, SQLITE_TRANSIENT); }
    sqlite3_bind_int(st, bi, limit);
    int any = 0;
    while (sqlite3_step(st) == SQLITE_ROW) {
        any = 1;
        const unsigned char *name = sqlite3_column_text(st, 0);
        double price = sqlite3_column_double(st, 1);
        const unsigned char *cur = sqlite3_column_text(st, 3);
        const unsigned char *kind = sqlite3_column_text(st, 4);
        const unsigned char *brand = sqlite3_column_text(st, 5);
        printf("%-40.40s %7.2f %s  [%s]%s%s\n", name, price, cur ? (const char*)cur : "DKK",
               kind ? (const char*)kind : "", brand ? " @ " : "", brand ? (const char*)brand : "");
    }
    sqlite3_finalize(st);
    if (!any) printf("No data yet — run `scrape` first.\n");
}

/* cheapest offer matching ANY term; returns 1 and fills out params if found */
static int cheapest_for(const char **terms, int n, char *name_out, size_t nout,
                        double *price_out, char *store_out, size_t sout) {
    char sql[2048]; strcpy(sql,
        "SELECT p.name,o.price,o.store_brand,o.source FROM offers o "
        "JOIN products p ON p.id=o.product_id WHERE ");
    for (int i = 0; i < n; i++) { strcat(sql, i ? " OR wmatch(p.name,?)" : "wmatch(p.name,?)"); }
    strcat(sql, " ORDER BY o.price ASC LIMIT 1");
    sqlite3_stmt *st; sqlite3_prepare_v2(DB, sql, -1, &st, NULL);
    for (int i = 0; i < n; i++) { char q[128]; norm_name(q, sizeof q, terms[i]);
        sqlite3_bind_text(st, i+1, q, -1, SQLITE_TRANSIENT); }
    int found = 0;
    if (sqlite3_step(st) == SQLITE_ROW) {
        found = 1;
        snprintf(name_out, nout, "%s", sqlite3_column_text(st, 0));
        *price_out = sqlite3_column_double(st, 1);
        const unsigned char *brand = sqlite3_column_text(st, 2);
        const unsigned char *src = sqlite3_column_text(st, 3);
        snprintf(store_out, sout, "%s", brand ? (const char*)brand : (src ? (const char*)src : "?"));
    }
    sqlite3_finalize(st);
    return found;
}

/* pizza recipe: each ingredient is a NULL-terminated list of synonym terms */
static const char *R_mel[]  = {"hvedemel","pizzamel","00 mel",NULL};
static const char *R_gaer[] = {"gær",NULL};
static const char *R_tom[]  = {"tomat","hakkede tomat","flåede tomat","passata","tomatsauce",NULL};
static const char *R_moz[]  = {"mozzarella",NULL};
static const char *R_ost[]  = {"revet ost","pizzatopping",NULL};
static const char *R_pep[]  = {"pepperoni","salami",NULL};
static const char **PIZZA[] = { R_mel, R_gaer, R_tom, R_moz, R_ost, R_pep, NULL };

static int term_count(const char **t) { int n = 0; while (t[n]) n++; return n; }

static void basket_print(const char ***ingredients) {
    double total = 0;
    for (int i = 0; ingredients[i]; i++) {
        const char **terms = ingredients[i];
        char name[256], store[128]; double price;
        if (cheapest_for(terms, term_count(terms), name, sizeof name, &price, store, sizeof store)) {
            total += price;
            printf("  %-22s -> %6.2f kr  %-32.32s @ %s\n", terms[0], price, name, store);
        } else {
            printf("  %-22s -> (intet tilbud i data)\n", terms[0]);
        }
    }
    printf("  %-22s -> %6.2f kr\n", "TOTAL", total);
    printf("  (NB: navne-match er omtrentligt — kilderne har ingen EAN)\n");
}

static void cmd_basket(const char *what) {
    if (strcmp(what, "pizza") == 0) {
        printf("=== Billigste 'pizza'-kurv ===\n");
        basket_print(PIZZA);
        return;
    }
    /* comma-separated ingredient list -> one term each */
    printf("=== Billigste kurv ===\n");
    char buf[1024]; snprintf(buf, sizeof buf, "%s", what);
    const char **lists[64]; int n = 0;
    char *save = NULL;
    for (char *tok = strtok_r(buf, ",", &save); tok && n < 63; tok = strtok_r(NULL, ",", &save)) {
        while (*tok == ' ') tok++;
        const char **one = malloc(2 * sizeof(char*));
        one[0] = strdup(tok); one[1] = NULL;
        lists[n++] = one;
    }
    lists[n] = NULL;
    basket_print(lists);
    for (int i = 0; i < n; i++) { free((void*)lists[i][0]); free((void*)lists[i]); }
}

static void cmd_history(const char *ean) {
    sqlite3_stmt *st;
    sqlite3_prepare_v2(DB,
        "SELECT o.price,o.currency,o.kind,o.observed_at FROM offers o "
        "JOIN products p ON p.id=o.product_id WHERE p.ean=? ORDER BY o.observed_at", -1, &st, NULL);
    sqlite3_bind_text(st, 1, ean, -1, SQLITE_TRANSIENT);
    int any = 0;
    while (sqlite3_step(st) == SQLITE_ROW) {
        any = 1;
        printf("  %s  %7.2f %s  [%s]\n", sqlite3_column_text(st, 3), sqlite3_column_double(st, 0),
               sqlite3_column_text(st, 1), sqlite3_column_text(st, 2));
    }
    sqlite3_finalize(st);
    if (!any) printf("No product with that EAN stored yet.\n");
}

/* ----------------------------------------------------------------------- */
/* CLI                                                                       */
/* ----------------------------------------------------------------------- */
static const char *opt(int argc, char **argv, const char *flag) {
    for (int i = 0; i < argc - 1; i++) if (strcmp(argv[i], flag) == 0) return argv[i+1];
    return NULL;
}
static int has_flag(int argc, char **argv, const char *flag) {
    for (int i = 0; i < argc; i++) if (strcmp(argv[i], flag) == 0) return 1;
    return 0;
}

static void usage(void) {
    fprintf(stderr,
        "usage: pricewatch [--db FILE] <command>\n"
        "  scrape --source {salling|rema1000|tjek} [--zip N|--ean N|--dealer-id ID|--dk-grocery]\n"
        "  latest [--query TEXT] [--limit N]\n"
        "  basket <pizza|mel,mozzarella,...>\n"
        "  dealers [--dk-grocery]\n"
        "  history --ean N\n");
}

int main(int argc, char **argv) {
    curl_global_init(CURL_GLOBAL_DEFAULT);
    const char *db_path = opt(argc, argv, "--db"); if (!db_path) db_path = getenv("PRICEWATCH_DB");
    if (!db_path) db_path = "pricewatch.db";
    /* find the command (first non-option, non-value token) */
    const char *cmd = NULL; int cmd_i = 0;
    for (int i = 1; i < argc; i++) {
        if (strcmp(argv[i], "--db") == 0) { i++; continue; }
        if (argv[i][0] != '-') { cmd = argv[i]; cmd_i = i; break; }
    }
    if (!cmd) { usage(); return 2; }
    db_open(db_path);

    if (strcmp(cmd, "scrape") == 0) {
        const char *src = opt(argc, argv, "--source"); if (!src) src = "tjek";
        if (strcmp(src, "salling") == 0) {
            const char *zip = opt(argc, argv, "--zip"), *ean = opt(argc, argv, "--ean");
            if (!zip && !ean) { fprintf(stderr, "scrape --source salling needs --zip and/or --ean\n"); return 2; }
            salling_scrape(zip, ean);
        } else if (strcmp(src, "rema1000") == 0) {
            rema_scrape();
        } else if (strcmp(src, "tjek") == 0) {
            tjek_scrape(opt(argc, argv, "--dealer-id"), has_flag(argc, argv, "--dk-grocery"));
        } else { fprintf(stderr, "unknown source: %s\n", src); return 2; }
        printf("[%s] stored %d price observation(s) in %s\n", src, INGESTED, db_path);
    } else if (strcmp(cmd, "latest") == 0) {
        const char *q = opt(argc, argv, "--query");
        const char *ls = opt(argc, argv, "--limit"); int limit = ls ? atoi(ls) : 30;
        cmd_latest(q, limit);
    } else if (strcmp(cmd, "basket") == 0) {
        const char *what = (cmd_i + 1 < argc) ? argv[cmd_i + 1] : NULL;
        if (!what) { fprintf(stderr, "basket needs an argument (e.g. pizza)\n"); return 2; }
        cmd_basket(what);
    } else if (strcmp(cmd, "dealers") == 0) {
        tjek_dealers(has_flag(argc, argv, "--dk-grocery"), 1, NULL);
    } else if (strcmp(cmd, "history") == 0) {
        const char *ean = opt(argc, argv, "--ean");
        if (!ean) { fprintf(stderr, "history needs --ean\n"); return 2; }
        cmd_history(ean);
    } else { usage(); return 2; }

    sqlite3_close(DB);
    curl_global_cleanup();
    return 0;
}

